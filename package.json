{
  "name": "luftify-workspace",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "sync:product": "node scripts/sync-product-config.mjs",
    "build": "pnpm sync:product && pnpm --filter @luft/protocol-types build && pnpm --filter @luft/desktop build",
    "build:app": "pnpm --filter @luft/desktop tauri build --bundles nsis",
    "dev": "pnpm --filter @luft/desktop tauri dev -- -- --libre",
    "dev:mock": "pnpm --filter @luft/desktop tauri dev -- -- --mock",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
